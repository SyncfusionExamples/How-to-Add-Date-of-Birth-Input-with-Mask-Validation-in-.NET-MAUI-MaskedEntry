<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="DOBInput.MainPage"
             BackgroundColor="#F5F5F5">

   <ScrollView>
       <VerticalStackLayout Padding="30"
                            Spacing="20">

           <!-- Title -->
           <Label Text="Date of Birth"
                  FontSize="24"
                  FontAttributes="Bold"
                  TextColor="#1f1f1f"
                  Margin="0,20,0,0" />

           <!-- Description -->
           <Label Text="Enter your date of birth in MM/DD/YYYY format"
                  FontSize="13"
                  TextColor="#666666"
                  Margin="0,0,0,10" />

           <!-- Masked Entry for Date of Birth -->
           <editors:SfMaskedEntry x:Name="dateOfBirthEntry"
                                  Mask="00/00/0000"
                                  PromptChar="_"
                                  Placeholder="MM/DD/YYYY"
                                  Padding="10"
                                  FontSize="16"
                                  TextColor="#1f1f1f"
                                  VerticalOptions="Start"
                                  HorizontalOptions="Fill"
                                  HeightRequest="50">
               <editors:SfMaskedEntry.Background>
                   <SolidColorBrush Color="White" />
               </editors:SfMaskedEntry.Background>
           </editors:SfMaskedEntry>

           <!-- Validation Result -->
           <Label x:Name="validationLabel"
                  Text=""
                  FontSize="13"
                  Margin="0,10,0,0" />

           <!-- Submit Button -->
           <Button Text="Validate Date"
                   Clicked="OnValidateButtonClicked"
                   Padding="15,12"
                   CornerRadius="8"
                   FontSize="16"
                   FontAttributes="Bold"
                   BackgroundColor="#2E7D32"
                   TextColor="White"
                   Margin="0,20,0,0" />

           <!-- Result Display -->
           <VerticalStackLayout x:Name="resultPanel"
                                IsVisible="False"
                                Padding="15"
                                Spacing="10"
                                BackgroundColor="White"
                                Margin="0,20,0,0">

               <Label Text="Validation Result:"
                      FontSize="14"
                      FontAttributes="Bold"
                      TextColor="#1f1f1f" />

               <Label x:Name="resultLabel"
                      Text=""
                      FontSize="13"
                      TextColor="#333333"
                      LineBreakMode="WordWrap" />
           </VerticalStackLayout>

       </VerticalStackLayout>
   </ScrollView>

</ContentPage>
